<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".AddCarteActivity">

    <EditText
        android:id="@+id/etNume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nume"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/etAutor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_autor"
        android:inputType="textPersonName" />

    <Spinner
        android:id="@+id/spGen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:entries="@array/genuri_carti" />

    <EditText
        android:id="@+id/etAn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_an"
        android:inputType="number" />

    <EditText
        android:id="@+id/etPret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_pret"
        android:inputType="number" />

    <CheckBox
        android:id="@+id/cbCitita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cb_citita" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGoleste"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btnGoleste" />

        <Button
            android:id="@+id/btnSalveaza"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_salveaza" />
    </LinearLayout>

</LinearLayout>