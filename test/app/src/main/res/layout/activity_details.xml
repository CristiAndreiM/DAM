<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvPopulatie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvRegiune"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvResedinta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnCauta_pe_Google"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_Cauta_pe_Google"/>
    <Button
        android:id="@+id/btnDistribuie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_Distribuie"/>
    <Button
        android:id="@+id/btnSuna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_Suna"/>

</LinearLayout>