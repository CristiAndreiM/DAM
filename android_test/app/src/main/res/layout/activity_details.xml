<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddRestaurantActivity">

    <TextView
        android:id="@+id/etNume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
       />

    <TextView
        android:id="@+id/spBucatarie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        />

    <TextView
        android:id="@+id/etPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_phone"
        android:textSize="20dp"
       />

    <TextView
        android:id="@+id/etRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_rating"
        android:textSize="20dp"
        />

    <TextView
        android:id="@+id/cbLivrare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_livreaza"
        android:textSize="20dp"
        />

    <Button
        android:id="@+id/btnSuna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_suna"
        android:textSize="20dp"
        />
    <Button
        android:id="@+id/btnDistribuie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_distribuie"
        android:textSize="20dp"
        />
</LinearLayout>